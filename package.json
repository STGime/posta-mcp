{
  "name": "posta-mcp",
  "version": "0.1.2",
  "description": "MCP server for Posta (getposta.app) — schedule and publish to multiple social platforms from any MCP client (Claude Desktop, Cursor, Windsurf, VS Code, Zed, …).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "posta-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "posta",
    "social-media",
    "scheduling",
    "instagram",
    "tiktok",
    "linkedin",
    "bluesky",
    "youtube",
    "pinterest",
    "x",
    "twitter"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
